{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "Performance Improvements",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "release-as": "0.1.0",
      "package-name": "kubeglance",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "draft": false,
      "prerelease": false,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "pkg/version/version.go",
        {
          "type": "yaml",
          "path": "charts/kubeglance/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/kubeglance/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  }
}
